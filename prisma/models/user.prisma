model User {
  id Int @id @default(autoincrement())
  user_id String @unique @default(uuid())
  email        String   @unique
  password String
  name         String?
  avatarUrl    String?
  workspace Workspace[]
   workspaceMembers WorkSpaceMembers[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}